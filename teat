local LastPositions = {}
local LastTimes = {}
local LastVelocities = {}

local function GetSmoothedVelocity(plr)
    local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then return Vector3.zero end
    local now = tick()
    local id = plr.UserId

    if LastPositions[id] and LastTimes[id] then
        local dt = now - LastTimes[id]
        if dt > 0 and dt < 0.5 then
            local raw = (root.Position - LastPositions[id]) / dt
            local old = LastVelocities[id] or raw
            local smooth = old:Lerp(raw, 0.65)
            LastVelocities[id] = smooth
            LastPositions[id] = root.Position
            LastTimes[id] = now
            return smooth
        end
    end
    LastPositions[id] = root.Position
    LastTimes[id] = now
    LastVelocities[id] = root.Velocity
    return root.Velocity
end

local function GetPing()
    local ping = 0.08
    local np = LP:FindFirstChild("NetworkPing")
    if np then ping = np.Value or 0.08 end
    return ping
end

local function IsPlayerValid(plr)
    return plr and plr.Character 
        and plr.Character:FindFirstChild("HumanoidRootPart") 
        and plr.Character:FindFirstChild("Humanoid") 
        and plr.Character:FindFirstChild("Head")
end

local function IsVisible(part, parent)
    if not getgenv().Looten.Adjustment.Checks.Wall_Check then return true end
    local char = LP.Character or LP.CharacterAdded:Wait()
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char, Camera}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local res = Workspace:Raycast(origin, part.Position - origin, params)
    return not res or res.Instance:IsDescendantOf(parent)
end

local function GetClosestBodyPart(char)
    local closestDist = math.huge
    local best = nil
    for _, p in pairs(char:GetChildren()) do
        if p:IsA("BasePart") and (p.Name == "Head" or p.Name == "HumanoidRootPart" or p.Name == "UpperTorso" or p.Name == "LowerTorso") then
            local s, on = Camera:WorldToViewportPoint(p.Position)
            if on then
                local d = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(s.X, s.Y)).Magnitude
                if d < closestDist then
                    closestDist = d
                    best = p
                end
            end
        end
    end
    return best
end

local function GetBestTarget()
    local best, dist = nil, math.huge
    local mpos = UserInputService:GetMouseLocation()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local c = p.Character
            if getgenv().Looten.Adjustment.Checks.Knocked_Check then
                local be = c:FindFirstChild("BodyEffects")
                if be and be:FindFirstChild("K.O") and be["K.O"].Value then continue end
                if c:FindFirstChild("GRABBING_CONSTRAINT") then continue end
            end
            if IsVisible(c.HumanoidRootPart, c) then
                local pos, onscreen = Camera:WorldToViewportPoint(c.HumanoidRootPart.Position)
                if onscreen then
                    local d = (mpos - Vector2.new(pos.X, pos.Y)).Magnitude
                    if d < dist and d <= getgenv().Looten.Fov.SilentAim.Radius then
                        dist = d
                        best = p
                    end
                end
            end
        end
    end
    return best
end

local function CalculatePrediction(target)
    if not IsPlayerValid(target) then return nil, nil end
    local char = target.Character
    local hitName = getgenv().Looten.Silent.HitPart.HitPart
    if getgenv().Looten.Silent.HitPart.NearestPoint then
        local nearest = GetClosestBodyPart(char)
        if nearest then hitName = nearest.Name end
    end
    local tPart = char:FindFirstChild(hitName)
    if not tPart then return nil, nil end

    local vel = GetSmoothedVelocity(target)
    local totalPred = getgenv().Looten.Silent.Prediction.Prediction + GetPing()
    local finalPos = tPart.Position

    local usePred = false
    if getgenv().DD then
        local mag = vel.Magnitude
        local mov = char.Humanoid.MoveDirection.Magnitude
        if mag > getgenv().DV or (mag < 1 and mov > 0.01) or (mag > 5 and mov < 0.01) then
            usePred = true
        end
    end

    if getgenv().Looten.Adjustment.Checks.NoGroundShots and vel.Y < getgenv().WAGA then
        finalPos = tPart.Position + Vector3.new(vel.X, vel.Y * getgenv().AGV, vel.Z) * totalPred
    elseif getgenv().DUG and vel.Y < getgenv().UD then
        finalPos = tPart.Position + Vector3.new(vel.X, 0, vel.Z) * totalPred
    elseif usePred or getgenv().Looten.Silent.Prediction.Enabled then
        finalPos = tPart.Position + vel * totalPred
    end

    return finalPos, tPart
end

