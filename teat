local function CheckGun()
    local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
    if not tool then return false end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return false end
    local name = tool.Name:lower()
    -- Wallets, Phones etc. ausschließen
    if name:find("wallet") or name:find("phone") or name:find("bat") then return false end
    return true
end

table.insert(getgenv().SchmecktHubConnections, RunService.RenderStepped:Connect(function()
    if not Shared.SilentAim then
        UI.Enabled = false
        Target, Pos, Part = nil, nil, nil
        return
    end
    UI.Enabled = true

    local mpos = UserInputService:GetMouseLocation()
    Circle.Position = UDim2.fromOffset(mpos.X, mpos.Y)

    IsGunEquipped = CheckGun()

    -- Zustand zurücksetzen
    Target, Pos, Part = nil, nil, nil
    TargetMarker.Visible = false
    Stroke.Color = Color3.fromRGB(255, 255, 255)

    if not IsGunEquipped then return end

    local found = GetBestTarget()
    if not found then return end

    local pPos, pPart = CalculatePrediction(found)
    if not pPos or not pPart then return end

    Target = found
    Pos = pPos
    Part = pPart

    local s, onScreen = Camera:WorldToViewportPoint(pPos)
    if onScreen then
        TargetMarker.Visible = true
        TargetMarker.Position = UDim2.fromOffset(s.X, s.Y)
        Stroke.Color = Color3.fromRGB(255, 50, 50)
    end
end))

local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if not checkcaller() and IsGunEquipped and Target and Pos and Shared.SilentAim and self == Mouse then
        if key == "Hit" then
            return CFrame.new(Pos)
        elseif key == "Target" then
            return Part
        elseif key == "X" then
            return Pos.X
        elseif key == "Y" then
            return Pos.Y
        elseif key == "Z" then
            return Pos.Z
        end
    end
    return oldIndex(self, key)
end))

getgenv().SchmecktHub_Destroy = function()
    for _, c in pairs(getgenv().SchmecktHubConnections) do
        pcall(function() c:Disconnect() end)
    end
    if UI then UI:Destroy() end
    VelocityHistory = {}
    Shared.SilentAim = false
    Target, Pos, Part = nil, nil, nil
end
