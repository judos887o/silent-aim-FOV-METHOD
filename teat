    if i.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = true UpdateSlider(i) end
end))
table.insert(getgenv().SchmecktHubConnections, Knob.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = true UpdateSlider(i) end
end))
table.insert(getgenv().SchmecktHubConnections, UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
end))
table.insert(getgenv().SchmecktHubConnections, UserInputService.InputChanged:Connect(function(i)
    if Dragging and i.UserInputType == Enum.UserInputType.MouseMovement then UpdateSlider(i) end
end))

local function CheckGun()
    local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
    return tool and tool:FindFirstChild("Handle") 
        and not tool.Name:lower():find("wallet") 
        and not tool.Name:lower():find("phone")
end

table.insert(getgenv().SchmecktHubConnections, RunService.RenderStepped:Connect(function()
    if not Shared.SilentAim then UI.Enabled = false return end
    UI.Enabled = true

    local mpos = UserInputService:GetMouseLocation()
    Circle.Position = UDim2.fromOffset(mpos.X, mpos.Y)

    IsGunEquipped = CheckGun()

    Target, Pos, Part = nil, nil, nil
    TargetMarker.Visible = false
    Stroke.Color = Color3.fromRGB(255, 255, 255)

    if IsGunEquipped then
        local found = GetBestTarget()
        if found then
            Target = found
            local pPos, pPart = CalculatePrediction(found)
            if pPos then
                Pos = pPos
                Part = pPart
                local s, on = Camera:WorldToViewportPoint(pPos)
                if on then
                    TargetMarker.Visible = true
                    TargetMarker.Position = UDim2.fromOffset(s.X, s.Y)
                    Stroke.Color = Color3.fromRGB(255, 50, 50)
                end
            end
        end
    end
end))

local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if not checkcaller() and IsGunEquipped and Target and Pos and Shared.SilentAim and self == Mouse then
        if key == "Hit" then
            return CFrame.new(Pos)
        elseif key == "Target" then
            return Part
        elseif key == "X" then
            return Pos.X
        elseif key == "Y" then
            return Pos.Y
        elseif key == "Z" then
            return Pos.Z
        end
    end
    return oldIndex(self, key)
end))

getgenv().SchmecktHub_Destroy = function()
    for _, c in pairs(getgenv().SchmecktHubConnections) do
        pcall(function() c:Disconnect() end)
    end
    if UI then UI:Destroy() end
    Shared.SilentAim = false
end
