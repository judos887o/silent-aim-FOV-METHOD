-- Slider Logik
local Dragging = false
local function UpdateSlider(input)
    local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
    local newFOV = math.floor(40 + (260 * pos))
    getgenv().Looten.Fov.Radius = newFOV
    Knob.Position = UDim2.new(pos, 0, 0.5, 0)
    Circle.Size = UDim2.new(0, newFOV * 2, 0, newFOV * 2)
    SliderLabel.Text = "FOV: " .. newFOV
end

table.insert(getgenv().SchmecktHubConnections, Track.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = true UpdateSlider(i) end
end))
table.insert(getgenv().SchmecktHubConnections, Knob.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = true UpdateSlider(i) end
end))
table.insert(getgenv().SchmecktHubConnections, UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
end))
table.insert(getgenv().SchmecktHubConnections, UserInputService.InputChanged:Connect(function(i)
    if Dragging and i.UserInputType == Enum.UserInputType.MouseMovement then UpdateSlider(i) end
end))

--// Main Loop
table.insert(getgenv().SchmecktHubConnections, RunService.RenderStepped:Connect(function()
    local mpos = UserInputService:GetMouseLocation()
    Circle.Position = UDim2.fromOffset(mpos.X, mpos.Y) -- Hier wird die Position gesetzt

    local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
    IsGunEquipped = tool and tool:FindFirstChild("Handle") and not tool.Name:lower():find("wallet")
    
    Target, Pos, Part = nil, nil, nil
    TargetMarker.Visible = false
    Stroke.Color = Color3.new(1, 1, 1)

    if IsGunEquipped then
        local best, bestDist = nil, getgenv().Looten.Fov.Radius
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChild("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    -- Knocked Check
                    if getgenv().Looten.Checks.Knocked_Check then
                        local be = p.Character:FindFirstChild("BodyEffects")
                        if be and be:FindFirstChild("K.O") and be["K.O"].Value then continue end
                    end

                    local sPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local d = (mpos - Vector2.new(sPos.X, sPos.Y)).Magnitude
                        if d < bestDist then
                            -- Wall Check
                            local origin = Camera.CFrame.Position
                            local params = RaycastParams.new()
                            params.FilterDescendantsInstances = {LP.Character, Camera}
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            local res = Workspace:Raycast(origin, (hrp.Position - origin), params)
                            
                            if not res or res.Instance:IsDescendantOf(p.Character) then
                                bestDist = d
                                best = p
                            end
                        end
                    end
                end
            end
        end

        if best then
            local char = best.Character
            local hitName = getgenv().Looten.Silent.HitPart
            local tPart = char:FindFirstChild(hitName)
            if tPart then
                local vel, accel = GetResolvedVelocity(best)
                local ping = GetRealPing()
                local t = getgenv().Looten.Silent.Prediction + (ping * 0.5)
                
                local outPos = tPart.Position + (Vector3.new(vel.X, 0, vel.Z) * t) + (0.5 * accel * t * t)
                if not IsGrounded(char) then
                    outPos = Vector3.new(outPos.X, tPart.Position.Y + (vel.Y * t) + (0.5 * GRAVITY.Y * t * t), outPos.Z)
                else
                    outPos = Vector3.new(outPos.X, tPart.Position.Y, outPos.Z)
                end

                Target = best
                Pos = outPos
                Part = tPart
                Stroke.Color = Color3.new(1, 0, 0)
                
                local sPos, onScreen = Camera:WorldToViewportPoint(outPos)
                if onScreen then
                    TargetMarker.Visible = true
                    TargetMarker.Position = UDim2.fromOffset(sPos.X, sPos.Y)
                end
            end
        end
    end
end))

--// Hook
local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if not checkcaller() and IsGunEquipped and Target and Pos and self == Mouse then
        if key == "Hit" then return CFrame.new(Pos)
        elseif key == "Target" then return Part end
    end
    return oldIndex(self, key)
end))

