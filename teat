local function GetPing()
    local ok, val = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    -- Stats gibt ms zurück → in Sekunden umrechnen
    -- Nur halber Ping (One-Way), da der Schuss bereits unterwegs ist
    if ok and val and val > 0 then
        return (val / 1000) * 0.5
    end
    return 0.04 -- Fallback: 40ms one-way
end

local function IsPlayerValid(plr)
    return plr 
        and plr.Character 
        and plr.Character:FindFirstChild("HumanoidRootPart") 
        and plr.Character:FindFirstChild("Humanoid") 
        and plr.Character:FindFirstChild("Head")
end

local function IsVisible(part, parent)
    if not getgenv().Looten.Adjustment.Checks.Wall_Check then return true end
    local char = LP.Character
    if not char then return false end
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char, Camera}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local res = Workspace:Raycast(origin, (part.Position - origin), params)
    return not res or res.Instance:IsDescendantOf(parent)
end

local function GetClosestBodyPart(char)
    local mPos = UserInputService:GetMouseLocation()
    local best, bestDist = nil, math.huge
    local candidates = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso"}
    for _, name in ipairs(candidates) do
        local p = char:FindFirstChild(name)
        if p then
            local s, on = Camera:WorldToViewportPoint(p.Position)
            if on then
                local d = (mPos - Vector2.new(s.X, s.Y)).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = p
                end
            end
        end
    end
    return best
end

local function GetBestTarget()
    local best, bestDist = nil, math.huge
    local mpos = UserInputService:GetMouseLocation()
    local radius = getgenv().Looten.Fov.SilentAim.Radius

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP or not p.Character then continue end
        local c = p.Character
        local hrp = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChild("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end

        -- Knocked/Grabbed Check
        if getgenv().Looten.Adjustment.Checks.Knocked_Check then
            local be = c:FindFirstChild("BodyEffects")
            if be and be:FindFirstChild("K.O") and be["K.O"].Value then continue end
            if c:FindFirstChild("GRABBING_CONSTRAINT") then continue end
        end

        if IsVisible(hrp, c) then
            local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local dist = (mpos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if dist < bestDist and dist <= radius then
                    bestDist = dist
                    best = p
                end
            end
        end
    end
    return best
end

local function CalculatePrediction(target)
    if not IsPlayerValid(target) then return nil, nil end
    local char = target.Character

    -- Zielteil bestimmen
    local hitName = getgenv().Looten.Silent.HitPart.HitPart
    if getgenv().Looten.Silent.HitPart.NearestPoint then
        local nearest = GetClosestBodyPart(char)
        if nearest then hitName = nearest.Name end
    end

    local tPart = char:FindFirstChild(hitName)
    if not tPart then return nil, nil end

    -- Velocity aus dem stabilen History-Buffer
    local vel = GetSmoothedVelocity(target)

    -- Prediction-Zeit: Nutzer-Wert + echter One-Way-Ping
    local totalPred = getgenv().Looten.Silent.Prediction.Prediction + GetPing()

    -- Sicherheits-Clamp: Nie mehr als 0.45s vorhersagen
    totalPred = math.clamp(totalPred, 0.05, 0.45)

    local basePos = tPart.Position
    local finalPos = basePos

    local yVel = vel.Y
    local flatVel = Vector3.new(vel.X, 0, vel.Z)

    -- Vertikale Prediction-Logik (sauber und eindeutig):
    if getgenv().Looten.Adjustment.Checks.NoGroundShots and yVel < getgenv().WAGA then
        -- Spieler fällt stark: Y-Velocity dämpfen (AGV = Dämpfungsfaktor)
        finalPos = basePos + Vector3.new(vel.X, vel.Y * getgenv().AGV, vel.Z) * totalPred

    elseif getgenv().DUG and yVel < getgenv().UD then
        -- Spieler fällt sehr stark: Y-Komponente komplett ignorieren
        finalPos = basePos + flatVel * totalPred

    else
        -- Normaler Fall: Volle Velocity-Prediction (wenn aktiviert)
        if getgenv().Looten.Silent.Prediction.Enabled then
            finalPos = basePos + vel * totalPred
        end
        -- DD (Dynamic Detection) überschreibt nicht mehr die Prediction-Aktivierung,
        -- sondern dient nur noch als Debug-Info (Logik war fehlerhaft im Original)
    end

    return finalPos, tPart
end

