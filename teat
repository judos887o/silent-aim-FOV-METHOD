--// Physics Functions (Präzise Berechnung)
local function GetRealPing()
    local ok, ping = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return (ok and ping and ping > 0) and (ping / 1000) or 0.07
end

local function IsGrounded(char)
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return true end
    if hum.FloorMaterial ~= Enum.Material.Air then return true end
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char, LP.Character}
    local res = workspace:Raycast(hrp.Position, Vector3.new(0, -5, 0), params)
    return res ~= nil
end

local function GetResolvedVelocity(player)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return Vector3.zero, Vector3.zero end

    local pid = player.UserId
    if not VelocityHistory[pid] then
        VelocityHistory[pid] = {pos = {}, vel = {}, t = {}}
    end

    local hist = VelocityHistory[pid]
    local now = tick()
    local rawVel = root.AssemblyLinearVelocity
    local moveDir = hum.MoveDirection
    
    local resolvedVel = rawVel
    if rawVel.Magnitude > 75 or (rawVel.Y > 35 or rawVel.Y < -35) or (rawVel.Magnitude > 1 and moveDir.Magnitude == 0) then
        resolvedVel = moveDir * hum.WalkSpeed
    end

    table.insert(hist.pos, root.Position)
    table.insert(hist.vel, resolvedVel)
    table.insert(hist.t, now)

    if #hist.pos > HISTORY_SIZE then
        table.remove(hist.pos, 1)
        table.remove(hist.vel, 1)
        table.remove(hist.t, 1)
    end

    local avgVel = Vector3.zero
    for i = 1, #hist.vel do avgVel = avgVel + hist.vel[i] end
    avgVel = avgVel / #hist.vel

    local accel = Vector3.zero
    if #hist.vel > 2 then
        local dt = hist.t[#hist.t] - hist.t[1]
        accel = (hist.vel[#hist.vel] - hist.vel[1]) / dt
    end
    
    if accel.Magnitude > 100 then accel = Vector3.zero end
    return avgVel, accel
end

