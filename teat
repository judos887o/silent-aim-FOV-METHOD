local HISTORY_SIZE = 8
local MAX_PLAUSIBLE_SPEED = 110 -- studs/s, alles darüber ist ein Netzwerksprung

-- Pro Spieler: Ringpuffer der letzten N Positionen + Zeitstempel
local VelocityHistory = {}

local function GetSmoothedVelocity(plr)
    local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then return Vector3.zero end

    local pid = plr.UserId
    local now = tick()
    local pos = root.Position

    if not VelocityHistory[pid] then
        VelocityHistory[pid] = { positions = {}, times = {}, lastSmooth = Vector3.zero }
    end

    local hist = VelocityHistory[pid]

    -- Neuen Eintrag hinzufügen
    table.insert(hist.positions, pos)
    table.insert(hist.times, now)

    -- Buffer auf HISTORY_SIZE begrenzen
    while #hist.positions > HISTORY_SIZE do
        table.remove(hist.positions, 1)
        table.remove(hist.times, 1)
    end

    -- Mindestens 2 Frames nötig
    if #hist.positions < 2 then
        return Vector3.zero
    end

    -- Velocity über den gesamten Buffer berechnen (ältester → neuester Eintrag)
    -- Das ist stabiler als frame-by-frame, weil kurze Ausreißer geglättet werden
    local oldPos = hist.positions[1]
    local oldTime = hist.times[1]
    local dt = now - oldTime

    if dt < 0.001 then return hist.lastSmooth end

    local rawVel = (pos - oldPos) / dt
    local speed = rawVel.Magnitude

    -- Plausibilitätsprüfung: Netzwerksprung oder Teleport erkannt
    if speed > MAX_PLAUSIBLE_SPEED then
        -- Fallback: Nur letzten Frame nutzen (kurzfristig stabiler)
        local prevPos = hist.positions[#hist.positions - 1]
        local prevTime = hist.times[#hist.times - 1]
        local shortDt = now - prevTime

        if shortDt > 0.001 then
            local shortVel = (pos - prevPos) / shortDt
            if shortVel.Magnitude <= MAX_PLAUSIBLE_SPEED then
                -- EMA mit dem letzten gültigen Smooth-Wert
                local alpha = 0.35 -- Niedriger = mehr Glättung, weniger Reaktivität
                local smoothed = hist.lastSmooth:Lerp(shortVel, alpha)
                hist.lastSmooth = smoothed
                return smoothed
            end
        end
        -- Komplett ungültig: letzten bekannten Wert zurückgeben
        return hist.lastSmooth
    end

    -- Normaler Fall: EMA über Buffer-Velocity
    -- alpha = 0.35 → neue Messung hat 35% Gewicht, letzter Smooth-Wert 65%
    -- Das filtert Frame-Rauschen ohne zu viel Reaktivität zu verlieren
    local alpha = 0.35
    local smoothed = hist.lastSmooth:Lerp(rawVel, alpha)
    hist.lastSmooth = smoothed
    return smoothed
end

